# Turso (https://turso.tech) — create a database and copy its URL + token.
# Leave these empty in local development: the store falls back to data/store.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password for the private /admin dashboard (products, prices and stock).
# Required: with no value set, /admin refuses to sign anyone in.
# Local development: put it in .env.local (gitignored).
# Production: add it in Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=
